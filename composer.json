{
    "name": "pixim/univers-sensoriel",
    "type": "project",
    "license": "MIT",
    "description": "Univers Sensoriel — WordPress (Bedrock + Sage)",
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "oscarotero/env": "^2.0",
        "roots/acorn": "^6.3",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "7.1.4",
        "roots/wp-config": "^1.0",
        "vlucas/phpdotenv": "^5.0",
        "wp-plugin/complianz-gdpr": "^7.5",
        "wp-plugin/forminator": "^1.58",
        "wp-plugin/secure-custom-fields": "^6.9",
        "wp-plugin/woocommerce": "^11.3",
        "wp-plugin/woocommerce-gateway-stripe": "^11.2",
        "wp-plugin/wordpress-seo": "^28.9",
        "wp-theme/twentytwentyfive": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "wp-cli/wp-cli-bundle": "^2.11"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "process-timeout": 0
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "web/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "web/wp"
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "pest",
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
        ],
        "seed": [
            "@php vendor/wp-cli/wp-cli/php/boot-fs.php plugin activate woocommerce wordpress-seo forminator complianz-gdpr woocommerce-gateway-stripe secure-custom-fields",
            "@php vendor/wp-cli/wp-cli/php/boot-fs.php language plugin install --all fr_FR",
            "@php vendor/wp-cli/wp-cli/php/boot-fs.php eval-file scripts/seed.php --user=admin",
            "@php vendor/wp-cli/wp-cli/php/boot-fs.php rewrite flush"
        ],
        "seo": "@php vendor/wp-cli/wp-cli/php/boot-fs.php eval-file scripts/seo.php --user=admin",
        "reglages": "@php vendor/wp-cli/wp-cli/php/boot-fs.php eval-file scripts/reglages.php --user=admin"
    }
}
